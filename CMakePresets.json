{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "dev",
			"displayName": "Dev (Debug + tests)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"EMBER_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "dev-release",
			"displayName": "Dev (Release + tests)",
			"inherits": "dev",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "asan",
			"displayName": "Dev (Debug + ASan/UBSan + tests)",
			"inherits": "dev",
			"cacheVariables": {
				"CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
				"CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
				"CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
			}
		}
	],
	"buildPresets": [
		{ "name": "dev", "configurePreset": "dev" },
		{ "name": "dev-release", "configurePreset": "dev-release" },
		{ "name": "asan", "configurePreset": "asan" }
	],
	"testPresets": [
		{
			"name": "test-common",
			"hidden": true,
			"output": { "outputOnFailure": true },
			"execution": { "jobs": 8, "noTestsAction": "error" }
		},
		{ "name": "dev", "inherits": "test-common", "configurePreset": "dev" },
		{ "name": "dev-release", "inherits": "test-common", "configurePreset": "dev-release" },
		{ "name": "asan", "inherits": "test-common", "configurePreset": "asan" }
	],
	"workflowPresets": [
		{
			"name": "dev",
			"displayName": "Configure + build + test (Debug)",
			"steps": [
				{ "type": "configure", "name": "dev" },
				{ "type": "build", "name": "dev" },
				{ "type": "test", "name": "dev" }
			]
		},
		{
			"name": "dev-release",
			"steps": [
				{ "type": "configure", "name": "dev-release" },
				{ "type": "build", "name": "dev-release" },
				{ "type": "test", "name": "dev-release" }
			]
		},
		{
			"name": "asan",
			"steps": [
				{ "type": "configure", "name": "asan" },
				{ "type": "build", "name": "asan" },
				{ "type": "test", "name": "asan" }
			]
		}
	]
}
